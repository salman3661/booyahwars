{
  "name": "booyahwars",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/AeroxApiAdmin/:path*",
      "destination": "/api/index?path=AeroxApiAdmin/:path*"
    },
    {
      "source": "/:file*.php",
      "destination": "/api/index?path=:file*.php"
    }
  ],
  "headers": [
    {
      "source": "/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"BooyahWars.apk\""
        }
      ]
    }
  ]
}
